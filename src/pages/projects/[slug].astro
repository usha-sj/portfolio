---
// /projects/<slug>: the desktop with that project's window open (loader skipped).
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Desktop from '../../components/desktop/Desktop.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
---

<Base title={`${project.data.title} · ${siteConfig.title}`} skipLoader>
  <Desktop initialWindow={`project/${project.id}`} />
</Base>
