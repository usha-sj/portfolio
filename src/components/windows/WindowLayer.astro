---
// Holds every window: the chrome template, one content template per app/project,
// and the layer windows are placed in. The manager lives in src/scripts/windows.ts.
import { getCollection } from 'astro:content';
import { apps, projectApp, projectFileApp, videoApp } from '../../config/apps';
import { siteConfig } from '../../config/site';
import Window from './Window.astro';
import FinderWindow from './FinderWindow.astro';
import NotesWindow from './NotesWindow.astro';
import MapsWindow from './MapsWindow.astro';
import MailWindow from './MailWindow.astro';
import TerminalWindow from './TerminalWindow.astro';
import TrashWindow from './TrashWindow.astro';
import ProjectFolderWindow from './ProjectFolderWindow.astro';
import ProjectTextWindow from './ProjectTextWindow.astro';
import ProjectVideoWindow from './ProjectVideoWindow.astro';
import QuickLook from './QuickLook.astro';

interface Props {
  /** Window to open on page load (from the URL), e.g. 'notes' or 'project/foo' */
  initial?: string;
}

const { initial } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const appTemplates = [
  { app: apps.finder, Content: FinderWindow, props: { projects } },
  { app: apps.notes, Content: NotesWindow, props: {} },
  { app: apps.maps, Content: MapsWindow, props: {} },
  { app: apps.mail, Content: MailWindow, props: {} },
  { app: apps.terminal, Content: TerminalWindow, props: {} },
  { app: apps.trash, Content: TrashWindow, props: {} },
];
---

<Window />

{
  appTemplates.map(({ app, Content, props }) => (
    <template
      data-window-template={app.id}
      data-app={app.id}
      data-app-label={app.label}
      data-title={app.title}
      data-path={app.path}
      data-size={app.size}
    >
      <Content {...props} />
    </template>
  ))
}

{
  projects.map((project) => (
    <>
      {/* The project folder (Finder window) */}
      <template
        data-window-template={`project/${project.id}`}
        data-app="finder"
        data-app-label={projectApp.label}
        data-title={project.data.title}
        data-path={`${projectApp.pathPrefix}${project.id}`}
        data-size={projectApp.size}
      >
        <ProjectFolderWindow project={project} />
      </template>
      {/* README.txt inside it (TextEdit window) */}
      <template
        data-window-template={`project/${project.id}${projectFileApp.pathSuffix}`}
        data-app={projectFileApp.id}
        data-app-label={projectFileApp.label}
        data-title={project.data.files.find((f) => f.type === 'txt')?.name ?? projectFileApp.fileName}
        data-path={`${projectApp.pathPrefix}${project.id}${projectFileApp.pathSuffix}`}
        data-size={projectFileApp.size}
      >
        <ProjectTextWindow project={project} />
      </template>
      {/* Videos (QuickTime): only once a real src is set. They keep the folder's URL. */}
      {project.data.files.map((file, i) =>
        file.type === 'video' && file.src ? (
          <template
            data-window-template={`project/${project.id}/video/${i}`}
            data-app={videoApp.id}
            data-app-label={videoApp.label}
            data-title={file.name}
            data-path={`${projectApp.pathPrefix}${project.id}`}
            data-routable="false"
            data-size={videoApp.size}
          >
            <ProjectVideoWindow src={file.src} poster={file.poster} label={`${project.data.title}: ${file.name}`} />
          </template>
        ) : null,
      )}
    </>
  ))
}

<QuickLook />

<div class="windows" data-window-layer data-initial-window={initial} data-site-title={siteConfig.title}></div>

<style>
  /* Covers the screen below the menu bar; windows inside are absolutely positioned.
     Clicks pass through to the desktop except on windows themselves. */
  .windows {
    position: fixed;
    inset: var(--menubar-h) 0 0;
    z-index: var(--z-windows);
    pointer-events: none;
  }
</style>

<!--
  Window content scripts are started here, NOT inside the window components:
  those components render inside <template>, where a <script> doesn't run until the
  window is cloned (and an inline one re-runs on every open). Content scripts listen
  for 'window:open' / 'window:close' and set up each new copy.
-->
<script>
  import { initContact } from '../../scripts/contact';
  import { initFinder } from '../../scripts/finder';
  import { initNotes } from '../../scripts/notes';
  import { initQuickLook } from '../../scripts/quicklook';
  import { initMaps } from '../../scripts/maps';
  import { initWindowManager } from '../../scripts/windows';

  // Content listeners first, so they catch the window opened from the URL
  initContact();
  initFinder();
  initNotes();
  initQuickLook();
  initMaps();
  initWindowManager();
</script>
