---
// A project folder, Finder-style: only the files that project has (from its `files` list).
//   txt   → README in TextEdit        image → Quick Look (arrows cycle every image here)
//   video → QuickTime window          link  → <name>.webloc, opens in a new tab
// Files without a path yet (video src '', link url '') are hidden.
// Click selects, double-click / Enter opens (Space opens images in Quick Look), via src/scripts/selection.ts.
import type { CollectionEntry } from 'astro:content';
import { linkFileExt, projectFileApp, windowText } from '../../config/apps';
import FileIcon from '../icons/FileIcon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const slug = project.id;
const files = project.data.files.filter(
  (f) => !(f.type === 'video' && !f.src) && !(f.type === 'link' && !f.url),
);
const readmeWindow = `project/${slug}${projectFileApp.pathSuffix}`;
// Video window ids use the file's position in the full list, matching WindowLayer.astro
const videoWindow = (name: string) => `project/${slug}/video/${project.data.files.findIndex((f) => f.name === name)}`;
const t = windowText.folder;
const count = files.length;
---

<div class="folder-window">
  <ul class="folder-window__grid" data-select-group>
    {
      files.map((file) => (
        <li>
          {file.type === 'txt' && (
            <button type="button" class="folder-window__item" data-select-open={readmeWindow} aria-describedby="select-open-hint">
              <span class="folder-window__icon">
                <FileIcon ext="txt" />
              </span>
              <span class="folder-window__name">{file.name}</span>
            </button>
          )}
          {file.type === 'image' && (
            <button
              type="button"
              class="folder-window__item"
              data-quicklook
              data-src={file.src}
              data-alt={file.alt}
              data-name={file.name}
              aria-describedby="select-open-hint"
            >
              <span class="folder-window__icon">
                <span class="folder-window__thumb" data-quicklook-thumb>
                  <img src={file.src} alt="" loading="lazy" decoding="async" />
                </span>
              </span>
              <span class="folder-window__name">{file.name}</span>
            </button>
          )}
          {file.type === 'video' && (
            <button type="button" class="folder-window__item" data-select-open={videoWindow(file.name)} aria-describedby="select-open-hint">
              <span class="folder-window__icon">
                {file.poster ? (
                  <span class="folder-window__thumb folder-window__thumb--video">
                    <img src={file.poster} alt="" loading="lazy" decoding="async" />
                  </span>
                ) : (
                  <FileIcon ext="mp4" kind="video" />
                )}
              </span>
              <span class="folder-window__name">{file.name}</span>
            </button>
          )}
          {file.type === 'link' && (
            <button type="button" class="folder-window__item" data-open-url={file.url} aria-describedby="select-open-hint">
              <span class="folder-window__icon">
                <FileIcon ext="url" kind="link" />
              </span>
              <span class="folder-window__name">
                {file.name}
                {linkFileExt}
              </span>
            </button>
          )}
        </li>
      ))
    }
  </ul>
  <p class="folder-window__status">{count === 1 ? t.countLabelOne : t.countLabel.replace('{n}', String(count))}</p>
</div>

<style>
  .folder-window {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    font-family: var(--font-system);
    font-size: var(--text-menubar);
  }

  .folder-window__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--folder-label-w), 1fr));
    gap: var(--space-4);
    flex: 1;
    align-content: start;
    margin: 0;
    padding: var(--space-5);
    list-style: none;
  }

  .folder-window__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    width: 100%;
    padding: var(--space-2) var(--space-1);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    font: inherit;
    color: inherit;
    text-align: center;
    cursor: default;
  }

  /* Every icon sits in the same square box so names line up */
  .folder-window__icon {
    display: grid;
    place-items: center;
    width: calc(var(--folder-icon-size) * 0.85);
    aspect-ratio: 1;
  }

  .folder-window__icon > :global(.file-icon) {
    width: 78%;
  }

  /* Image thumbnails: white mat + shadow, like Finder */
  .folder-window__thumb {
    display: block;
    max-width: 100%;
    max-height: 100%;
    padding: calc(var(--folder-thumb-border) * 2);
    background: var(--color-file-thumb-mat);
    box-shadow: var(--shadow-file-thumb);
  }

  .folder-window__thumb img {
    display: block;
    width: calc(var(--folder-icon-size) * 0.8);
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .folder-window__name {
    padding: 1px var(--space-1);
    border-radius: var(--radius-sm);
    overflow-wrap: anywhere;
  }

  .folder-window__item[data-selected] {
    background: var(--color-finder-selected);
  }

  .folder-window__item[data-selected] .folder-window__name {
    background: var(--color-folder-label-selected-bg);
    color: var(--color-folder-label-selected-text);
  }

  .folder-window__item:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .folder-window__status {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-top: var(--border-thin) solid var(--color-window-titlebar-border);
    font-size: var(--text-xs);
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
