---
// README.txt inside a project folder: a TextEdit-style document. The text is the Markdown
// body of the project's file in src/content/projects/ (edit it there).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<article class="readme">
  <h3 class="readme__title">{project.data.title}</h3>
  <p class="readme__meta">{[project.data.role, project.data.period ?? String(project.data.year)].join(' · ')}</p>
  <div class="readme__body">
    <Content />
  </div>
</article>

<style>
  .readme {
    min-height: 100%;
    padding: var(--space-8) var(--space-6) var(--space-12);
    background: var(--color-textedit-page);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text);
  }

  .readme > * {
    max-width: var(--textedit-w);
    margin-inline: auto;
  }

  .readme__title {
    margin-top: 0;
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.1;
  }

  .readme__meta {
    margin-top: 0;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Rendered Markdown, so its elements need :global */
  .readme__body :global(h2) {
    margin: var(--space-6) 0 var(--space-1);
    font-family: var(--font-system);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .readme__body :global(p) {
    margin: 0 0 var(--space-3);
  }
</style>
