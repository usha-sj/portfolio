---
// Preview: the résumé as a vertical timeline. Entries come from src/content/experience/,
// text and skills from src/config/resume.ts. Filtering + GSAP scroll animations live in
// src/scripts/resume.ts (set up each time the window opens).
import { getCollection } from 'astro:content';
import { resumeConfig as cfg } from '../../config/resume';

const all = await getCollection('experience');

// Newest first: by start date, then end date ('present' counts as newest), then `order`
const endKey = (end: string) => (end === 'present' ? '9999-99' : end);
const entries = all.sort(
  (a, b) =>
    b.data.start.localeCompare(a.data.start) ||
    endKey(b.data.end).localeCompare(endKey(a.data.end)) ||
    a.data.order - b.data.order,
);

const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const parse = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return { year: y, month: monthFmt.format(new Date(Date.UTC(y, m - 1, 1))) };
};
// "Jan – Apr 2026" within one year, "Aug 2024 – Aug 2025" across years, like the PDF
const dateRange = (start: string, end: string) => {
  const s = parse(start);
  if (end === 'present') return `${s.month} ${s.year} – ${cfg.present}`;
  const e = parse(end);
  return s.year === e.year ? `${s.month} – ${e.month} ${e.year}` : `${s.month} ${s.year} – ${e.month} ${e.year}`;
};

// Bullets can contain [text](url); split into plain text and link parts
const linkParts = (text: string) => {
  const parts: { text: string; href?: string }[] = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let last = 0;
  for (const m of text.matchAll(re)) {
    if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
};

// Only show filter chips that have entries (e.g. Teaching appears once you add one)
const typesPresent = new Set(entries.map((e) => e.data.type));
const filters = cfg.filters.filter((f) => f.value === 'all' || typesPresent.has(f.value as never));
---

<div
  class="resume"
  data-resume
  data-status={cfg.filterStatus}
  data-status-all={cfg.filterStatusAll}
>
  <div class="resume__toolbar">
    <div class="resume__filters" role="radiogroup" aria-label={cfg.filterLabel} data-resume-filters>
      {
        filters.map((f, i) => (
          <button
            type="button"
            class="resume__chip"
            role="radio"
            aria-checked={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? '0' : '-1'}
            data-filter={f.value}
            data-label={f.label.toLowerCase()}
          >
            {f.label}
          </button>
        ))
      }
    </div>
    <a class="resume__download" href={cfg.pdf} target="_blank" rel="noopener">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M3 12.5h10" /></svg>
      {cfg.downloadLabel}
    </a>
  </div>

  <p class="visually-hidden" aria-live="polite" data-resume-status></p>

  <div class="resume__content">
    <div class="timeline" data-timeline>
      <div class="timeline__line" aria-hidden="true">
        <div class="timeline__progress" data-timeline-progress></div>
      </div>

      <ol class="timeline__list">
        {
          entries.map(({ data }) => (
            <li class="timeline__entry" data-entry data-type={data.type}>
              <p class="timeline__date">{dateRange(data.start, data.end)}</p>
              <span class="timeline__marker" data-marker aria-hidden="true" />
              <article class="timeline__card" data-card>
                <div class="timeline__head">
                  {data.logo && <img class="timeline__logo" src={data.logo} alt="" />}
                  <div>
                    <span class:list={['timeline__type', `timeline__type--${data.type}`]}>
                      {cfg.typeLabels[data.type]}
                    </span>
                    <h3 class="timeline__title">{data.title}</h3>
                    <p class="timeline__org">
                      {data.link ? (
                        <a href={data.link} target="_blank" rel="noopener noreferrer">
                          {data.organisation}
                        </a>
                      ) : (
                        data.organisation
                      )}
                      {data.location && <span class="timeline__location"> · {data.location}</span>}
                    </p>
                  </div>
                </div>

                {data.description && <p class="timeline__desc">{data.description}</p>}

                {data.bullets.length > 0 && (
                  <ul class="timeline__bullets">
                    {data.bullets.map((b) => (
                      <li>
                        {linkParts(b).map((part) =>
                          part.href ? (
                            <a href={part.href} target="_blank" rel="noopener noreferrer">
                              {part.text}
                            </a>
                          ) : (
                            part.text
                          ),
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                {data.awards.length > 0 && (
                  <p class="timeline__extra">
                    <strong>{cfg.awardsLabel}:</strong> {data.awards.join(', ')}
                  </p>
                )}
                {data.courses.length > 0 && (
                  <p class="timeline__extra">
                    <strong>{cfg.coursesLabel}:</strong> {data.courses.join(', ')}
                  </p>
                )}
              </article>
            </li>
          ))
        }
      </ol>
    </div>

    <section class="skills" aria-labelledby="resume-skills-heading">
      <h3 class="skills__heading" id="resume-skills-heading">{cfg.skillsHeading}</h3>
      {
        cfg.skills.map((group) => (
          <div class="skills__group">
            <h4 class="skills__label">{group.label}</h4>
            <ul class="skills__list">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</div>

<style>
  .resume {
    min-height: 100%;
    background: var(--color-resume-bg);
    font-family: var(--font-body);
  }

  /* ---- Toolbar: sticks to the top of the window's scroll area ---- */
  .resume__toolbar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: var(--color-resume-toolbar);
    -webkit-backdrop-filter: var(--menubar-blur);
    backdrop-filter: var(--menubar-blur);
    border-bottom: var(--border-thin) solid var(--color-window-titlebar-border);
    font-family: var(--font-system);
    font-size: var(--text-menubar);
  }

  .resume__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .resume__chip {
    padding: var(--chip-pad);
    border: var(--border-thin) solid var(--color-chip-border);
    border-radius: var(--radius-pill);
    background: var(--color-chip-bg);
    font: inherit;
    color: var(--color-chip-text);
    cursor: pointer;
  }

  .resume__chip[aria-checked='true'] {
    background: var(--color-chip-active-bg);
    border-color: var(--color-chip-active-bg);
    color: var(--color-chip-active-text);
  }

  .resume__download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--chip-pad);
    border: var(--border-thin) solid var(--color-chip-border);
    border-radius: var(--radius-sm);
    background: var(--color-chip-bg);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-chip-text);
  }

  .resume__download svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .resume__content {
    max-width: var(--resume-max-w);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-12);
  }

  /* ---- Timeline: date | line + marker | card ---- */
  .timeline {
    position: relative;
  }

  .timeline__line {
    position: absolute;
    top: var(--space-2);
    bottom: var(--space-2);
    left: calc(var(--timeline-date-w) + var(--timeline-gutter) / 2 - var(--timeline-line-w) / 2);
    width: var(--timeline-line-w);
    background: var(--color-timeline-line);
    border-radius: var(--timeline-line-w);
  }

  /* GSAP scales this from 0 to 1 as you scroll; without JS/motion it's simply full */
  .timeline__progress {
    position: absolute;
    inset: 0;
    background: var(--color-timeline-progress);
    border-radius: inherit;
    transform-origin: top;
  }

  .timeline__list {
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__entry {
    display: grid;
    grid-template-columns: var(--timeline-date-w) var(--timeline-gutter) minmax(0, 1fr);
    align-items: start;
  }

  .timeline__entry[hidden] {
    display: none;
  }

  .timeline__date {
    margin: 0;
    padding-top: var(--space-4);
    font-family: var(--font-system);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: right;
    color: var(--color-timeline-date);
    font-variant-numeric: tabular-nums;
  }

  .timeline__marker {
    justify-self: center;
    width: var(--timeline-marker-size);
    height: var(--timeline-marker-size);
    margin-top: calc(var(--space-4) + 2px);
    border: 2px solid var(--color-timeline-marker-border);
    border-radius: 50%;
    background: var(--color-timeline-marker);
  }

  .timeline__card {
    padding: var(--space-4) var(--space-5);
    background: var(--color-card-bg);
    border: var(--border-hairline) solid var(--color-card-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-paper);
  }

  .timeline__head {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .timeline__logo {
    width: var(--timeline-logo-size);
    height: var(--timeline-logo-size);
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .timeline__type {
    display: inline-block;
    margin-bottom: var(--space-1);
    padding: 1px var(--space-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-system);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .timeline__type--work { background: var(--color-type-work-bg); color: var(--color-type-work-text); }
  .timeline__type--leadership { background: var(--color-type-leadership-bg); color: var(--color-type-leadership-text); }
  .timeline__type--teaching { background: var(--color-type-teaching-bg); color: var(--color-type-teaching-text); }
  .timeline__type--education { background: var(--color-type-education-bg); color: var(--color-type-education-text); }

  .timeline__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.2;
  }

  .timeline__org {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .timeline__org a,
  .timeline__bullets a {
    color: var(--color-accent);
  }

  .timeline__location {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .timeline__desc,
  .timeline__extra {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .timeline__extra strong {
    color: var(--color-text);
  }

  .timeline__bullets {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* ---- Skills ---- */
  .skills {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border-thin) solid var(--color-card-border);
  }

  .skills__heading {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
  }

  .skills__group + .skills__group {
    margin-top: var(--space-4);
  }

  .skills__label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-system);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .skills__list li {
    padding: 2px var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-skill-bg);
  }

  /* ---- Phone: single column, line on the left, date above each card ---- */
  @media (max-width: 767px) {
    .resume__content {
      padding: var(--space-6) var(--space-4) var(--space-12);
    }

    .timeline__line {
      left: calc(var(--timeline-gutter) / 2 - var(--timeline-line-w) / 2);
    }

    .timeline__entry {
      grid-template-columns: var(--timeline-gutter) minmax(0, 1fr);
      grid-template-areas:
        'marker date'
        'marker card';
    }

    .timeline__date {
      grid-area: date;
      padding: 0 0 var(--space-1);
      text-align: left;
    }

    .timeline__marker {
      grid-area: marker;
      margin-top: 3px;
    }

    .timeline__card {
      grid-area: card;
    }
  }
</style>
