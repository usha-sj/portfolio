---
// Mail window content (placeholder). Fill this in later; the chrome comes from Window.astro.
// To run JS when this window opens: add a module in src/scripts/ that listens for 'window:open'
// where detail.id === 'mail', and start it from WindowLayer.astro (no <script> in this file).
import { windowText } from '../../config/apps';

const text = windowText.mail;
---

<div class="mail-window">
  <h3 class="mail-window__heading">{text.heading}</h3>
  <p class="mail-window__body">{text.body}</p>
</div>

<style>
  .mail-window {
    padding: var(--space-6);
  }

  .mail-window__heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
  }

  .mail-window__body {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
