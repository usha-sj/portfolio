---
// Maps (Experience): an Apple Maps-style view of my route through experiences.
// Stops: src/data/route.ts. Entries: src/content/experience/ (each has a `stop`).
// Text: src/config/maps.ts. Behaviour + GSAP: src/scripts/maps.ts (started from WindowLayer.astro;
// no <script> here because this renders inside a <template>).
import { getCollection } from 'astro:content';
import { mapsConfig as c } from '../../config/maps';
import { mapScale, mapSize, stops } from '../../data/route';

const entries = (await getCollection('experience')).sort((a, b) => a.data.start.localeCompare(b.data.start));
const entriesFor = (stopId: string) => entries.filter((e) => e.data.stop === stopId);

// "Jan – Apr 2026" within a year, "Aug 2024 – Aug 2025" across years
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const parse = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return { year: y, month: monthFmt.format(new Date(Date.UTC(y, m - 1, 1))) };
};
const dateRange = (start: string, end: string) => {
  const s = parse(start);
  if (end === 'present') return `${s.month} ${s.year} – ${c.present}`;
  const e = parse(end);
  return s.year === e.year ? `${s.month} – ${e.month} ${e.year}` : `${s.month} ${s.year} – ${e.month} ${e.year}`;
};

// Bullets can contain [text](url)
const linkParts = (text: string) => {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const m of text.matchAll(/\[([^\]]+)\]\(([^)]+)\)/g)) {
    if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
};

// Smooth curve through every stop (Catmull-Rom → cubic Bézier)
const pts = stops.map((s) => [s.x, s.y]);
const routeD = pts
  .map(([x, y], i) => {
    if (i === 0) return `M${x} ${y}`;
    const p0 = pts[Math.max(i - 2, 0)];
    const p1 = pts[i - 1];
    const p2 = pts[i];
    const p3 = pts[Math.min(i + 1, pts.length - 1)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    return `C${c1[0]} ${c1[1]} ${c2[0]} ${c2[1]} ${x} ${y}`;
  })
  .join(' ');

// Skills filter: every tag used by any entry
const skills = [...new Set(entries.flatMap((e) => e.data.tags))].sort((a, b) => a.localeCompare(b));
const types = [...new Set(entries.map((e) => e.data.type))];
---

<div class="maps" data-maps data-scale={mapScale} data-stops={JSON.stringify(stops.map(({ id, x, y }) => ({ id, x, y })))}>
  <!-- Sidebar (a draggable bottom sheet on phones) -->
  <aside class="maps__sidebar" data-maps-sheet aria-label={c.directionsHeading}>
    <div class="maps__handle" data-maps-handle aria-hidden="true" title={c.sheetHandle}><span></span></div>
    <div class="maps__sidebar-scroll" data-maps-sheet-scroll>
      <section class="maps__tldr" aria-labelledby="maps-tldr-heading">
        <h3 class="maps__heading" id="maps-tldr-heading">{c.tldrHeading}</h3>
        <ul class="maps__tldr-list">
          {c.tldr.map((line) => <li>{line}</li>)}
        </ul>
        <p class="maps__label">{c.topSkillsLabel}</p>
        <ul class="maps__chips maps__chips--static">
          {c.topSkills.map((s) => <li>{s}</li>)}
        </ul>
        <a class="maps__download" href={c.pdf} download={c.pdfFileName}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M3 12.5h10" /></svg>
          {c.downloadLabel}
        </a>
      </section>

      <section aria-labelledby="maps-directions-heading">
        <h3 class="maps__heading" id="maps-directions-heading">{c.directionsHeading}</h3>
        <ol class="directions" data-directions>
          {
            stops.map((stop, i) => (
              <li class="directions__step" data-step={stop.id}>
                <button
                  type="button"
                  class="directions__button"
                  data-stop-index={i}
                  aria-controls={`maps-card-${stop.id}`}
                >
                  <span class:list={['directions__icon', `directions__icon--${stop.step}`]} aria-hidden="true" />
                  <span class="directions__text">
                    <span class="directions__title">
                      {c.stepLabels[stop.step]}
                      {stop.step !== 'here' && `: ${stop.city}`}
                    </span>
                    <span class="directions__meta">
                      {stop.dates} · {stop.caption}
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </section>

      <fieldset class="maps__layers">
        <legend class="maps__heading">{c.layersHeading}</legend>
        {
          c.layers
            .filter((l) => types.includes(l.value as never))
            .map((l) => (
              <label class="maps__layer">
                <input type="checkbox" data-layer={l.value} checked />
                <span class:list={['maps__layer-dot', `type--${l.value}`]} aria-hidden="true" />
                {l.label}
              </label>
            ))
        }
      </fieldset>

      <section aria-labelledby="maps-skills-heading">
        <h3 class="maps__heading" id="maps-skills-heading">{c.skillsHeading}</h3>
        <p class="maps__hint">{c.skillsHint}</p>
        <ul class="maps__chips" data-skills>
          {
            skills.map((s) => (
              <li>
                <button type="button" class="maps__chip" data-skill={s} aria-pressed="false">
                  {s}
                </button>
              </li>
            ))
          }
        </ul>
      </section>
      <p class="visually-hidden" aria-live="polite" data-maps-status></p>
      <p class="visually-hidden" aria-live="polite" data-maps-announce></p>
    </div>

    <!-- Place cards: the selected stop's card replaces the directions (like Apple Maps on the Mac) -->
    <div class="maps__cards">
      {
        stops.map((stop) => {
          const list = entriesFor(stop.id);
          return (
            <section
              class="place-card"
              id={`maps-card-${stop.id}`}
              data-place-card={stop.id}
              data-label={[stop.city + (stop.country ? `, ${stop.country}` : ''), stop.dates, stop.caption].join('. ')}
              aria-labelledby={`maps-card-title-${stop.id}`}
              hidden
            >
              <header class="place-card__header">
                <div>
                  <p class="place-card__step">{c.stepLabels[stop.step]}</p>
                  <h3 class="place-card__title" id={`maps-card-title-${stop.id}`} tabindex="-1">
                    {stop.city}
                    {stop.country && <span class="place-card__country">, {stop.country}</span>}
                  </h3>
                  <p class="place-card__meta">
                    {stop.dates} · {stop.caption}
                  </p>
                </div>
                <button type="button" class="place-card__close" data-card-close aria-label={c.closeCard}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                </button>
              </header>

              {stop.note && <p class="place-card__note">{stop.note}</p>}

              {list.map(({ id, data }) => (
                <article class="entry" data-entry data-type={data.type} data-tags={JSON.stringify(data.tags)}>
                  <p class="entry__kicker">
                    <span class:list={['entry__type', `type--${data.type}`]}>{c.typeLabels[data.type]}</span>
                    {data.mode && <span class="entry__mode">{c.modeLabels[data.mode]}</span>}
                  </p>
                  <h4 class="entry__title">{data.title}</h4>
                  <p class="entry__org">
                    {data.organisation} · {dateRange(data.start, data.end)}
                  </p>
                  {data.stat && (
                    <p class="entry__stat">
                      <span class="entry__stat-value" data-stat={data.stat.value}>
                        {data.stat.value}
                      </span>
                      <span class="entry__stat-label">{data.stat.label}</span>
                    </p>
                  )}
                  <p class="entry__summary">{data.summary}</p>
                  {data.tags.length > 0 && (
                    <ul class="entry__tags">
                      {data.tags.map((t) => (
                        <li data-tag={t}>{t}</li>
                      ))}
                    </ul>
                  )}
                  <div class="entry__actions">
                    {(data.bullets.length > 0 || data.description || data.awards.length > 0) && (
                      <button
                        type="button"
                        class="entry__toggle"
                        data-entry-toggle
                        aria-expanded="false"
                        aria-controls={`maps-entry-${id}`}
                        data-more={c.moreLabel}
                        data-less={c.lessLabel}
                      >
                        {c.moreLabel}
                      </button>
                    )}
                    {data.project && (
                      <button type="button" class="entry__folder" data-open-window={`project/${data.project}`}>
                        {c.openFolder}
                      </button>
                    )}
                  </div>
                  <div class="entry__details" id={`maps-entry-${id}`} hidden>
                    {data.description && <p>{data.description}</p>}
                    {data.bullets.length > 0 && (
                      <ul class="entry__bullets">
                        {data.bullets.map((b) => (
                          <li>
                            {linkParts(b).map((part) =>
                              part.href ? (
                                <a href={part.href} target="_blank" rel="noopener noreferrer">
                                  {part.text}
                                </a>
                              ) : (
                                part.text
                              ),
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                    {data.awards.length > 0 && (
                      <p>
                        <strong>{c.awardsLabel}:</strong> {data.awards.join(', ')}
                      </p>
                    )}
                    {data.courses.length > 0 && (
                      <p>
                        <strong>{c.coursesLabel}:</strong> {data.courses.join(', ')}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </section>
          );
        })
      }
    </div>
  </aside>

  <!-- Map -->
  <div class="maps__map" data-maps-viewport>
    <div class="maps__canvas" data-maps-canvas style={`width:${mapSize.width * mapScale}px;height:${mapSize.height * mapScale}px`}>
      <svg class="maps__svg" viewBox={`0 0 ${mapSize.width} ${mapSize.height}`} aria-hidden="true">
        <defs>
          <mask id="maps-route-mask" maskUnits="userSpaceOnUse">
            <path class="maps__route-mask" data-route-mask d={routeD} />
          </mask>
        </defs>

        <!-- Decorative paper-map details -->
        <path class="maps__water" d="M0 820c180-40 320 30 520 0s300-90 520-40 360 120 600 70 380-60 660-30V1000H0z" />
        <path class="maps__water" d="M1380 0c40 80 160 120 300 110s220-70 360-40 200 40 260 20V0z" />
        <g class="maps__contours">
          <path d="M80 200c120-60 260-40 360 20s200 40 300-10" />
          <path d="M60 250c140-60 300-40 400 30s220 50 320-10" />
          <path d="M1000 160c90-50 210-40 290 10s170 30 240-20" />
          <path d="M980 210c110-50 230-40 320 20s180 40 260-20" />
          <path d="M1560 860c110-60 240-50 330 0s190 40 290-10" />
          <path d="M640 900c90-40 200-30 280 10s150 20 220-20" />
        </g>
        <g class="maps__compass" transform={`translate(${mapSize.width - 110} 110)`}>
          <circle r="42" />
          <path d="M0-34 8 0 0 34-8 0z" />
          <text y="-48" text-anchor="middle">N</text>
        </g>

        <!-- Route: dashed line revealed by the mask (DrawSVG draws the mask) -->
        <path class="maps__route" d={routeD} mask="url(#maps-route-mask)" />
        <path class="maps__route-guide" data-route-guide d={routeD} />

        <!-- Pins -->
        {
          stops.map((stop, i) => (
            <g class="maps__pin-wrap" transform={`translate(${stop.x} ${stop.y})`}>
              <g class:list={['maps__pin', stop.step === 'here' && 'maps__pin--here']} data-pin={stop.id} data-stop-index={i}>
                <path class="maps__pin-shape" d="M0 0c-6-12-18-20-18-34a18 18 0 0 1 36 0c0 14-12 22-18 34z" />
                <circle class="maps__pin-dot" cy="-34" r="7" />
                <g class="maps__label" transform="translate(0 30)">
                  <text class="maps__label-city" text-anchor="middle">
                    {stop.city}
                  </text>
                  <text class="maps__label-caption" y="26" text-anchor="middle">
                    {stop.caption}
                  </text>
                </g>
              </g>
            </g>
          ))
        }

        <!-- "You" marker that travels along the route -->
        <g class="maps__marker" data-maps-marker>
          <circle class="maps__marker-halo" r="20" />
          <circle class="maps__marker-dot" r="9" />
        </g>
      </svg>
    </div>

    <div class="maps__controls">
      <button type="button" class="maps__control" data-maps-prev aria-label={c.previousStop}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button type="button" class="maps__control" data-maps-next aria-label={c.nextStop}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .maps {
    position: relative;
    display: grid;
    grid-template-columns: var(--maps-sidebar-w) minmax(0, 1fr);
    height: 100%;
    font-family: var(--font-system);
    font-size: var(--text-menubar);
    color: var(--color-text);
  }

  /* ---- Sidebar ---- */
  .maps__sidebar {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--color-maps-sidebar);
    border-right: var(--border-thin) solid var(--color-window-titlebar-border);
  }

  .maps__handle {
    display: none;
  }

  .maps__sidebar-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-4);
  }

  .maps__sidebar-scroll > * + * {
    margin-top: var(--space-5);
  }

  .maps__heading {
    margin: 0 0 var(--space-2);
    padding: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .maps__tldr-list {
    margin: 0 0 var(--space-2);
    padding-left: var(--space-4);
    line-height: 1.45;
  }

  .maps__label,
  .maps__hint {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .maps__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .maps__chips--static li,
  .maps__chip {
    padding: 2px var(--space-2);
    border: var(--border-thin) solid var(--color-chip-border);
    border-radius: var(--radius-pill);
    background: var(--color-chip-bg);
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-chip-text);
  }

  .maps__chip {
    cursor: pointer;
  }

  .maps__chip[aria-pressed='true'] {
    border-color: var(--color-chip-active-bg);
    background: var(--color-chip-active-bg);
    color: var(--color-chip-active-text);
  }

  .maps__download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding: var(--chip-pad);
    border-radius: var(--radius-sm);
    background: var(--color-mail-send-bg);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-mail-send-text);
  }

  .maps__download svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Directions: turn-by-turn steps joined by a dotted line */
  .directions {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directions__button {
    position: relative;
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }

  .directions__step:not(:last-child) .directions__button::after {
    content: '';
    position: absolute;
    left: calc(var(--space-2) + 0.7rem - 1px);
    top: calc(var(--space-2) + 1.2rem);
    bottom: calc(var(--space-2) * -1 + 2px);
    border-left: 2px dotted var(--color-maps-step);
    opacity: 0.5;
  }

  .directions__button:hover,
  .directions__step[aria-current] .directions__button {
    background: var(--color-notes-selected);
  }

  .directions__step.is-highlighted .directions__button {
    background: var(--color-maps-highlight);
  }

  .directions__step.is-dim {
    opacity: 0.45;
  }

  .directions__icon {
    width: 1.1rem;
    height: 1.1rem;
    margin: 2px auto 0;
    border: 3px solid var(--color-maps-pin);
    border-radius: 50%;
    background: var(--white);
  }

  .directions__icon--start {
    border-color: var(--color-maps-step);
  }

  .directions__icon--here {
    border-color: var(--color-maps-pin-here);
    background: var(--color-maps-pin-here);
  }

  .directions__text {
    display: grid;
  }

  .directions__title {
    font-weight: 600;
  }

  .directions__meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .maps__layers {
    margin-inline: 0;
    padding: 0;
    border: 0;
  }

  .maps__layer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 2px 0;
    cursor: pointer;
  }

  .maps__layer-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  /* Entry type colours (layers, card kicker) */
  .type--work { background: var(--color-type-work-bg); color: var(--color-type-work-text); }
  .type--research { background: var(--color-type-research-bg); color: var(--color-type-research-text); }
  .type--leadership { background: var(--color-type-leadership-bg); color: var(--color-type-leadership-text); }
  .type--education { background: var(--color-type-education-bg); color: var(--color-type-education-text); }

  /* ---- Map ---- */
  .maps__map {
    position: relative;
    isolation: isolate; /* contains the map's 3D layer (Safari) so it can't cover the sheet */
    overflow: hidden;
    background-color: var(--color-maps-paper);
    touch-action: none; /* drag/swipe pans the map; the wheel is left alone */
    cursor: grab;
  }

  .maps__map:active {
    cursor: grabbing;
  }

  /* Safari: the map is moved with plain 2D transforms (force3D: false in maps.ts) and nothing
     here creates 3D layers or backdrop blur. Composited layers made Safari paint the map
     over the place card regardless of z-index. */
  .maps__canvas {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    background-color: var(--color-maps-paper);
    background-image: var(--maps-grid);
  }

  .maps__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .maps__water { fill: var(--color-maps-water); }
  .maps__contours path { fill: none; stroke: var(--color-maps-contour); stroke-width: 2; }
  .maps__compass circle { fill: var(--color-maps-label-bg); stroke: var(--color-maps-contour); stroke-width: 2; }
  .maps__compass path { fill: var(--color-maps-route); opacity: 0.7; }
  .maps__compass text { fill: var(--color-maps-route); font: 700 18px var(--font-system); }

  .maps__route {
    fill: none;
    stroke: var(--color-maps-route);
    stroke-width: 5;
    stroke-dasharray: 2 16;
    stroke-linecap: round;
  }

  .maps__route-mask {
    fill: none;
    stroke: var(--white);
    stroke-width: 24;
  }

  .maps__route-guide {
    fill: none;
    stroke: none;
  }

  .maps__pin {
    cursor: pointer;
  }

  .maps__pin-shape {
    fill: var(--color-maps-pin);
    stroke: var(--color-maps-pin-ring);
    stroke-width: 3;
    filter: drop-shadow(0 3px 3px rgb(0 0 0 / 0.25));
  }

  .maps__pin--here .maps__pin-shape { fill: var(--color-maps-pin-here); }
  .maps__pin-dot { fill: var(--color-maps-pin-ring); }
  .maps__pin.is-dim .maps__pin-shape { fill: var(--color-maps-pin-dim); }
  .maps__pin.is-dim .maps__label { opacity: 0.45; }

  .maps__pin.is-selected .maps__pin-shape,
  .maps__pin.is-highlighted .maps__pin-shape {
    stroke: var(--color-maps-route);
    stroke-width: 4;
  }

  .maps__label-city {
    fill: var(--color-maps-label);
    font: 700 22px var(--font-system);
    paint-order: stroke;
    stroke: var(--color-maps-label-bg);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .maps__label-caption {
    fill: var(--color-text-muted);
    font: 500 17px var(--font-system);
    paint-order: stroke;
    stroke: var(--color-maps-label-bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .maps__marker-halo { fill: var(--color-maps-marker); opacity: 0.22; }
  .maps__marker-dot { fill: var(--color-maps-marker); stroke: var(--white); stroke-width: 4; }

  .maps__controls {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    z-index: 2;
    display: flex;
    gap: var(--space-1);
  }

  .maps__control {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: var(--border-thin) solid var(--color-chip-border);
    border-radius: var(--radius-md);
    background: var(--color-maps-card);
    box-shadow: var(--shadow-paper);
    color: var(--color-text);
    cursor: pointer;
  }

  .maps__control svg,
  .place-card__close svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- Place card: shown in the sidebar instead of the directions ---- */
  .maps__cards {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-4);
  }

  .maps__sidebar:not(.has-card) .maps__cards,
  .maps__sidebar.has-card .maps__sidebar-scroll {
