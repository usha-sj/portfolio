---
// Maps (Experience): an Apple Maps-style view of my route through experiences.
// Stops: src/data/route.ts. Entries: src/content/experience/ (each has a `stop`).
// Text: src/config/maps.ts. Behaviour + GSAP: src/scripts/maps.ts (started from WindowLayer.astro;
// no <script> here because this renders inside a <template>).
import { getCollection } from 'astro:content';
import { mapsConfig as c } from '../../config/maps';
import { highwayShields, mapLabels } from '../../data/mapLabels';
import { mapScale, mapSize, seed, stops as routeStops } from '../../data/route';
import { FONT, PIN, POI_ICON, getMap } from '../../lib/mapgen';

const entries = (await getCollection('experience')).sort((a, b) => a.data.start.localeCompare(b.data.start));
const entriesFor = (stopId: string) => entries.filter((e) => e.data.stop === stopId);

// "Jan – Apr 2026" within a year, "Aug 2024 – Aug 2025" across years
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const parse = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return { year: y, month: monthFmt.format(new Date(Date.UTC(y, m - 1, 1))) };
};
const dateRange = (start: string, end: string) => {
  const s = parse(start);
  if (end === 'present') return `${s.month} ${s.year} – ${c.present}`;
  const e = parse(end);
  return s.year === e.year ? `${s.month} – ${e.month} ${e.year}` : `${s.month} ${s.year} – ${e.month} ${e.year}`;
};

// Bullets can contain [text](url)
const linkParts = (text: string) => {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const m of text.matchAll(/\[([^\]]+)\]\(([^)]+)\)/g)) {
    if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
};

// The map background, stop positions, route and place names are generated at build time
// from a seed (src/lib/mapgen.ts). Same seed, same map.
const map = getMap({ seed, size: mapSize, stops: routeStops, labels: mapLabels, shields: highwayShields });
const stops = map.stops;

// Pin glyph: the stop's `glyph`, else its most common entry type (ties: work > research > education > leadership)
const glyphOrder = ['work', 'research', 'education', 'leadership'] as const;
const glyphFor = (stop: (typeof stops)[number]) => {
  if (stop.glyph) return stop.glyph;
  const counts = new Map<string, number>();
  entriesFor(stop.id).forEach((e) => counts.set(e.data.type, (counts.get(e.data.type) ?? 0) + 1));
  return [...glyphOrder].sort((a, b) => (counts.get(b) ?? 0) - (counts.get(a) ?? 0))[0];
};
// Pin glyphs (white strokes, centred on 0,0, ~16 units)
const pinGlyphs: Record<(typeof glyphOrder)[number], string> = {
  work: 'M-6.5-3h13v9h-13zM-2.5-3v-2.2h5V-3M-6.5 1h13',
  research: 'M-2.5-6.5h5M-1.5-6.5V-2L-6.5 6h13L1.5-2v-4.5M-4.2 2.5h8.4',
  education: 'M0-5.5 8-2 0 1.5-8-2zM-4.5-.5v3.5c2.5 2 6.5 2 9 0V-.5M8-2v4.5',
  leadership:
    'M-5.3-3.4a2.3 2.3 0 1 0 4.6 0a2.3 2.3 0 1 0-4.6 0M-7.5 5.5c.3-3 2-4.4 4.5-4.4s4.2 1.4 4.5 4.4M1.9-3a1.9 1.9 0 1 0 3.8 0a1.9 1.9 0 1 0-3.8 0M3 1.1c.3-.1.6-.1.8-.1 2.2 0 3.7 1.3 4 4.5',
};
// POI badge glyphs (white, ~12 units). `fill` = solid shape, otherwise drawn as lines.
const poiGlyphs: Record<string, { d: string; fill?: boolean }> = {
  park: { d: 'M0-6.5a4.6 4.6 0 0 1 4.4 6 3.4 3.4 0 0 1-2.4 4.9H.9V8h-1.8V4.4H-2a3.4 3.4 0 0 1-2.4-4.9A4.6 4.6 0 0 1 0-6.5z', fill: true },
  sports: { d: 'M-5.5 0a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0M-5.2-1.8c2.4 1 4.4 3.2 5 6.9M5.2-1.8c-2.4 1-4.4 3.2-5 6.9' },
  school: { d: 'M0-5.5 8-2 0 1.5-8-2zM-4.5-.5v3.5c2.5 2 6.5 2 9 0V-.5' },
  cafe: { d: 'M-5.5-2h9v4.5a4.5 4.5 0 0 1-9 0zM3.5-1h1.3a2 2 0 0 1 0 4H3.3M-3-6c0 1 .8 1.2.8 2.2M0-6c0 1 .8 1.2.8 2.2' },
  food: { d: 'M-3.5-6v12M-5.5-6v3.5a2 2 0 0 0 4 0V-6M3.5 6V-6c-1.8 1-2.6 3-2.6 5.5h2.6' },
  spa: { d: 'M0-6.5C2-3.5 4.5-1 4.5 1.8a4.5 4.5 0 0 1-9 0C-4.5-1-2-3.5 0-6.5z', fill: true },
  landmark: { d: 'M0-6.5l1.9 4 4.4.5-3.3 3 .9 4.4L0 3.2l-3.9 2.2.9-4.4-3.3-3 4.4-.5z', fill: true },
};
const fontFor = (l: (typeof map.labels)[number]) => (l.type === 'water' && l.kind === 'upright' ? FONT.lake : FONT[l.type]);

// Skills filter: every tag used by any entry
const skills = [...new Set(entries.flatMap((e) => e.data.tags))].sort((a, b) => a.localeCompare(b));
const types = [...new Set(entries.map((e) => e.data.type))];
---

<div class="maps" data-maps data-scale={mapScale} data-stops={JSON.stringify(stops.map(({ id, x, y }) => ({ id, x: Math.round(x), y: Math.round(y) })))}>
  <!-- Sidebar (a draggable bottom sheet on phones) -->
  <aside class="maps__sidebar" data-maps-sheet aria-label={c.directionsHeading}>
    <div class="maps__handle" data-maps-handle aria-hidden="true" title={c.sheetHandle}><span></span></div>
    <div class="maps__sidebar-scroll" data-maps-sheet-scroll>
      <section class="maps__tldr" aria-labelledby="maps-tldr-heading">
        <h3 class="maps__heading" id="maps-tldr-heading">{c.tldrHeading}</h3>
        <ul class="maps__tldr-list">
          {c.tldr.map((line) => <li>{line}</li>)}
        </ul>
        <p class="maps__label">{c.topSkillsLabel}</p>
        <ul class="maps__chips maps__chips--static">
          {c.topSkills.map((s) => <li>{s}</li>)}
        </ul>
        <a class="maps__download" href={c.pdf} download={c.pdfFileName}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M3 12.5h10" /></svg>
          {c.downloadLabel}
        </a>
      </section>

      <section aria-labelledby="maps-directions-heading">
        <h3 class="maps__heading" id="maps-directions-heading">{c.directionsHeading}</h3>
        <ol class="directions" data-directions>
          {
            stops.map((stop, i) => (
              <li class="directions__step" data-step={stop.id}>
                <button
                  type="button"
                  class="directions__button"
                  data-stop-index={i}
                  aria-controls={`maps-card-${stop.id}`}
                >
                  <span class:list={['directions__icon', `directions__icon--${stop.step}`]} aria-hidden="true" />
                  <span class="directions__text">
                    <span class="directions__title">
                      {c.stepLabels[stop.step]}
                      {stop.step !== 'here' && `: ${stop.city}`}
                    </span>
                    <span class="directions__meta">
                      {stop.dates}
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </section>

      <fieldset class="maps__layers">
        <legend class="maps__heading">{c.layersHeading}</legend>
        {
          c.layers
            .filter((l) => types.includes(l.value as never))
            .map((l) => (
              <label class="maps__layer">
                <input type="checkbox" data-layer={l.value} checked />
                <span class:list={['maps__layer-dot', `type--${l.value}`]} aria-hidden="true" />
                {l.label}
              </label>
            ))
        }
      </fieldset>

      <section aria-labelledby="maps-skills-heading">
        <h3 class="maps__heading" id="maps-skills-heading">{c.skillsHeading}</h3>
        <p class="maps__hint">{c.skillsHint}</p>
        <ul class="maps__chips" data-skills>
          {
            skills.map((s) => (
              <li>
                <button type="button" class="maps__chip" data-skill={s} aria-pressed="false">
                  {s}
                </button>
              </li>
            ))
          }
        </ul>
      </section>
      <p class="visually-hidden" aria-live="polite" data-maps-status></p>
      <p class="visually-hidden" aria-live="polite" data-maps-announce></p>
    </div>

    <!-- Place cards: the selected stop's card replaces the directions (like Apple Maps on the Mac) -->
    <div class="maps__cards">
      {
        stops.map((stop) => {
          const list = entriesFor(stop.id);
          return (
            <section
              class="place-card"
              id={`maps-card-${stop.id}`}
              data-place-card={stop.id}
              data-label={[stop.city + (stop.country ? `, ${stop.country}` : ''), stop.dates].join('. ')}
              aria-labelledby={`maps-card-title-${stop.id}`}
              hidden
            >
              <header class="place-card__header">
                <div>
                  <p class="place-card__step">{c.stepLabels[stop.step]}</p>
                  <h3 class="place-card__title" id={`maps-card-title-${stop.id}`} tabindex="-1">
                    {stop.city}
                    {stop.country && <span class="place-card__country">, {stop.country}</span>}
                  </h3>
                  <p class="place-card__meta">
                    {stop.dates}
                  </p>
                </div>
                <button type="button" class="place-card__close" data-card-close aria-label={c.closeCard}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                </button>
              </header>

              {stop.note && <p class="place-card__note">{stop.note}</p>}

              {list.map(({ id, data }) => (
                <article class="entry" data-entry data-type={data.type} data-tags={JSON.stringify(data.tags)}>
                  <p class="entry__kicker">
                    <span class:list={['entry__type', `type--${data.type}`]}>{c.typeLabels[data.type]}</span>
                    {data.mode && <span class="entry__mode">{c.modeLabels[data.mode]}</span>}
                  </p>
                  <h4 class="entry__title">{data.title}</h4>
                  <p class="entry__org">
                    {data.organisation} · {dateRange(data.start, data.end)}
                  </p>
                  {data.stat && (
                    <p class="entry__stat">
                      <span class="entry__stat-value" data-stat={data.stat.value}>
                        {data.stat.value}
                      </span>
                      <span class="entry__stat-label">{data.stat.label}</span>
                    </p>
                  )}
                  <p class="entry__summary">{data.summary}</p>
                  {data.tags.length > 0 && (
                    <ul class="entry__tags">
                      {data.tags.map((t) => (
                        <li data-tag={t}>{t}</li>
                      ))}
                    </ul>
                  )}
                  <div class="entry__actions">
                    {(data.bullets.length > 0 || data.description || data.awards.length > 0) && (
                      <button
                        type="button"
                        class="entry__toggle"
                        data-entry-toggle
                        aria-expanded="false"
                        aria-controls={`maps-entry-${id}`}
                        data-more={c.moreLabel}
                        data-less={c.lessLabel}
                      >
                        {c.moreLabel}
                      </button>
                    )}
                    {data.project && (
                      <button type="button" class="entry__folder" data-open-window={`project/${data.project}`}>
                        {c.openFolder}
                      </button>
                    )}
                  </div>
                  <div class="entry__details" id={`maps-entry-${id}`} hidden>
                    {data.description && <p>{data.description}</p>}
                    {data.bullets.length > 0 && (
                      <ul class="entry__bullets">
                        {data.bullets.map((b) => (
                          <li>
                            {linkParts(b).map((part) =>
                              part.href ? (
                                <a href={part.href} target="_blank" rel="noopener noreferrer">
                                  {part.text}
                                </a>
                              ) : (
                                part.text
                              ),
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                    {data.awards.length > 0 && (
                      <p>
                        <strong>{c.awardsLabel}:</strong> {data.awards.join(', ')}
                      </p>
                    )}
                    {data.courses.length > 0 && (
                      <p>
                        <strong>{c.coursesLabel}:</strong> {data.courses.join(', ')}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </section>
          );
        })
      }
    </div>
  </aside>

  <!-- Map -->
  <div class="maps__map" data-maps-viewport>
    <div class="maps__canvas" data-maps-canvas style={`width:${mapSize.width * mapScale}px;height:${mapSize.height * mapScale}px`}>
      <svg class="maps__svg" viewBox={`0 0 ${mapSize.width} ${mapSize.height}`} aria-hidden="true">
        <!-- Generated background (see src/lib/mapgen.ts) -->
        <rect class="map-land" width={mapSize.width} height={mapSize.height} />
        <g class="map-landuse">{map.landuse.map((l) => <path class={`map-landuse--${l.kind}`} d={l.d} />)}</g>
        <g class="map-streets">{map.streetsD.map((d) => <path d={d} />)}</g>
        <g class="map-parks">{map.parksD.map((d) => <path d={d} />)}</g>
        <!-- Water twice: shoreline strokes, then fills on top, so the lake/river join has no seam -->
        <g class="map-water map-water--shore">
          <path d={map.lakeD} />
          <path d={map.riverD} />
        </g>
        <g class="map-water">
          <path d={map.lakeD} />
          <path d={map.riverD} />
        </g>
        <g class="map-roads">
          {map.roads.filter((r) => r.kind !== 'connector').map((r) => <path class:list={['map-road-casing', `map-road-casing--${r.kind}`]} d={r.d} />)}
          {map.bridges.map((b) => <path class:list={['map-bridge-shadow', `map-bridge-shadow--${b.kind}`]} d={b.d} />)}
          {map.bridges.map((b) => <path class:list={['map-bridge', `map-bridge--${b.kind}`]} d={b.d} />)}
          {map.roads.map((r) => <path class:list={['map-road', `map-road--${r.kind}`]} d={r.d} />)}
        </g>

        <!-- Route: Apple Maps directions line (DrawSVG draws both strokes in) -->
        <path class="maps__route-casing" data-route-casing d={map.routeD} />
        <path class="maps__route" data-route-guide d={map.routeD} />

        <!-- Highway shields -->
        {
          map.shields.map((sh) => (
            <g transform={`translate(${sh.x} ${sh.y})`}>
              <g data-upright="free">
                <rect class="map-shield" x={-(14 + sh.text.length * 4.5)} y="-12" width={28 + sh.text.length * 9} height="24" rx="6" />
                <text class="map-shield__text" text-anchor="middle" dominant-baseline="central" font-size="15">
                  {sh.text}
                </text>
              </g>
            </g>
          ))
        }

        <!-- Place names. Path labels follow their road/street/river; the rest stay upright. -->
        <g class="map-labels">
          {
            map.labels.map((l, i) => (
              <g
                class:list={['ml', `ml--${l.type}`, l.category && `ml--${l.category}`, c.revealOnZoom.includes(l.type) && 'ml--zoom']}
                transform={`translate(${l.x} ${l.y})`}
                data-map-label
                data-x={l.x}
                data-y={l.y}
                data-w={l.w}
                data-h={l.h}
              >
                {l.kind === 'path' ? (
                  <g data-upright="path" data-angle={l.angle}>
                    <path class="ml__path" id={`maps-lp-${i}`} d={l.pathD} />
                    <path class="ml__path" id={`maps-lp-${i}-r`} d={l.pathRevD} />
                    <text font-size={fontFor(l)}>
                      <textPath href={`#maps-lp-${i}`} data-path-id={`maps-lp-${i}`} startOffset="50%" text-anchor="middle" dominant-baseline="central">
                        {l.text}
                      </textPath>
                    </text>
                  </g>
                ) : l.category ? (
                  // Apple Maps-style category badge, then the name
                  <g data-upright="free">
                    <g class="ml__badge" transform={`translate(${-l.w / 2 + POI_ICON.r} 0)`}>
                      <circle r={POI_ICON.r} />
                      <path class:list={[poiGlyphs[l.category].fill && 'is-fill']} transform="scale(1.1)" d={poiGlyphs[l.category].d} />
                    </g>
                    <text x={-l.w / 2 + POI_ICON.r * 2 + POI_ICON.gap} dominant-baseline="central" font-size={fontFor(l)}>
                      {l.text}
                    </text>
                  </g>
                ) : (
                  <g data-upright="free">
                    <text text-anchor="middle" dominant-baseline="central" font-size={fontFor(l)}>
                      {l.text}
                    </text>
                  </g>
                )}
              </g>
            ))
          }
        </g>

        <!-- Pins (stay upright and the same size when the map rotates/zooms) -->
        {
          stops.map((stop, i) => (
            <g transform={`translate(${Math.round(stop.x)} ${Math.round(stop.y)})`}>
              <g data-upright="free">
                {stop.step === 'here' ? (
                  // "You are here": Apple's blue location dot
                  <g class="maps__pin maps__pin--here" data-pin={stop.id} data-stop-index={i}>
                    <g class="maps__puck" data-pin-body data-puck>
                      <circle class="maps__puck-halo" r="30" data-puck-halo />
                      <circle class="maps__puck-ring" r="15" />
                      <circle class="maps__puck-dot" r="10.5" />
                    </g>
                    <text
                      class="maps__pin-label"
                      x={stop.labelSide === 'right' ? 24 : -24}
                      y={0}
                      text-anchor={stop.labelSide === 'right' ? 'start' : 'end'}
                      dominant-baseline="central"
                      font-size={FONT.stop}
                    >
                      <tspan class="maps__pin-city">{stop.city}</tspan>
                      <tspan class="maps__pin-dates"> · {stop.dates.replace(/\s*–\s*/g, '–')}</tspan>
                    </text>
                  </g>
                ) : (
                  <g class="maps__pin" data-pin={stop.id} data-stop-index={i}>
                    <g class="maps__pin-body" data-pin-body>
                      <path
                        class="maps__pin-shape"
                        d={`M-6.5 ${-PIN.head + 16.8}L0 0L6.5 ${-PIN.head + 16.8}A${PIN.r} ${PIN.r} 0 1 0 -6.5 ${-PIN.head + 16.8}Z`}
                      />
                      <path class="maps__pin-glyph" transform={`translate(0 ${-PIN.head}) scale(1.15)`} d={pinGlyphs[glyphFor(stop)]} />
                    </g>
                    <text
                      class="maps__pin-label"
                      x={stop.labelSide === 'right' ? PIN.r * 1.45 + PIN.labelGap : -(PIN.r * 1.45 + PIN.labelGap)}
                      y={-PIN.head}
                      text-anchor={stop.labelSide === 'right' ? 'start' : 'end'}
                      dominant-baseline="central"
                      font-size={FONT.stop}
                    >
                      <tspan class="maps__pin-city">{stop.city}</tspan>
                      <tspan class="maps__pin-dates"> · {stop.dates.replace(/\s*–\s*/g, '–')}</tspan>
                    </text>
                  </g>
                )}
              </g>
            </g>
          ))
        }

        <!-- "You" marker that travels along the route -->
        <g class="maps__marker" data-maps-marker>
          <g data-upright="free">
            <circle class="maps__marker-halo" r="22" />
            <circle class="maps__marker-dot" r="10" />
          </g>
        </g>
      </svg>
    </div>

    <!-- Apple Maps-style controls, top right -->
    <div class="maps__tools">
      <div class="maps__tool-group">
        <button type="button" class="maps__tool" data-maps-zoom-in aria-label={c.zoomIn} title={c.zoomIn}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
        </button>
        <button type="button" class="maps__tool" data-maps-zoom-out aria-label={c.zoomOut} title={c.zoomOut}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg>
        </button>
      </div>
      <button type="button" class="maps__tool maps__tool--round maps__compass" data-maps-compass aria-label={c.compass} title={c.compass}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <g class="maps__compass-rose" data-compass-rose>
            <path class="maps__compass-north" d="M16 2.5l3.2 6.5h-6.4z" />
            <text x="16" y="16.5" text-anchor="middle" dominant-baseline="central">{c.compassNorth}</text>
            <path class="maps__compass-south" d="M14.6 25h2.8v4h-2.8z" />
          </g>
        </svg>
      </button>
      <button type="button" class="maps__tool maps__tool--round" data-maps-recenter aria-label={c.recenter} title={c.recenter}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="maps__recenter-arrow" d="M13.5 2.5 2.5 7.2l4.8 1.5 1.5 4.8z" /></svg>
      </button>
    </div>

    <div class="maps__controls">
      <button type="button" class="maps__control" data-maps-prev aria-label={c.previousStop}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button type="button" class="maps__control" data-maps-next aria-label={c.nextStop}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .maps {
    position: relative;
    display: grid;
    grid-template-columns: var(--maps-sidebar-w) minmax(0, 1fr);
    height: 100%;
    font-family: var(--font-system);
    font-size: var(--text-menubar);
    color: var(--color-text);
  }

  /* ---- Sidebar ---- */
  .maps__sidebar {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--color-maps-sidebar);
    border-right: var(--border-thin) solid var(--color-window-titlebar-border);
  }

  .maps__handle {
    display: none;
  }

  .maps__sidebar-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-4);
  }

  .maps__sidebar-scroll > * + * {
    margin-top: var(--space-5);
  }

  .maps__heading {
    margin: 0 0 var(--space-2);
    padding: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .maps__tldr-list {
    margin: 0 0 var(--space-2);
    padding-left: var(--space-4);
    line-height: 1.45;
  }

