---
import { apps, dockApps, mobileDockApps } from '../../config/apps';
import { desktopConfig } from '../../config/desktop';
import AppIcon from '../icons/AppIcon.astro';

const items = dockApps.map((id) => apps[id]);
const trash = apps.trash;
---

<!--
  GSAP hooks: [data-dock], [data-dock-item] (each li), and the onDockHover /
  onDockMove / onDockLeave functions in the script below (also fired as
  dock:hover / dock:move / dock:leave events). Items get [data-running] when open.
-->
<nav class="dock" aria-label={desktopConfig.dockLabel} data-dock data-anim="dock">
  <ul class="dock__list">
    {
      items.map((app) => (
        <li
          class:list={['dock__item', !mobileDockApps.includes(app.id) && 'dock__item--desktop-only']}
          data-dock-item
          data-dock-app={app.id}
          data-label={app.label}
        >
          <button type="button" class="dock__button" data-open-window={app.id} aria-label={app.label}>
            <AppIcon app={app.id} />
          </button>
          <span class="dock__tooltip" aria-hidden="true">{app.label}</span>
          <span class="dock__dot" aria-hidden="true"></span>
        </li>
      ))
    }
    <li class="dock__separator dock__item--desktop-only" aria-hidden="true"></li>
    <li class="dock__item dock__item--desktop-only" data-dock-item data-dock-app={trash.id} data-label={trash.label}>
      <button type="button" class="dock__button" data-open-window={trash.id} aria-label={trash.label}>
        <AppIcon app="trash" />
      </button>
      <span class="dock__tooltip" aria-hidden="true">{trash.label}</span>
      <span class="dock__dot" aria-hidden="true"></span>
    </li>
  </ul>
</nav>

<style>
  .dock {
    position: fixed;
    bottom: var(--space-2);
    left: 50%;
    translate: -50% 0;
    z-index: var(--z-dock);
    padding: var(--dock-pad) var(--dock-pad) calc(var(--dock-pad) / 2);
    /* Translucent like the menu bar (intentional exception to the no-glass rule) */
    background: var(--color-dock-bg);
    -webkit-backdrop-filter: var(--dock-blur);
    backdrop-filter: var(--dock-blur);
    border: var(--border-thin) solid var(--color-dock-border);
    border-radius: var(--radius-dock);
    box-shadow: var(--shadow-dock);
    font-family: var(--font-system);
  }

  .dock__list {
    display: flex;
    align-items: flex-end;
    gap: var(--dock-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dock__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dock__button {
    display: block;
    width: var(--dock-icon-size);
    padding: 0;
    border: 0;
    border-radius: var(--radius-icon);
    background: none;
    cursor: pointer;
  }

  /* Static hover only; magnification comes later via GSAP (uses `translate`, so
     GSAP's transform/scale on the icon won't fight it) */
  .dock__button:hover {
    translate: 0 -2px;
  }

  .dock__button:focus-visible {
    outline-offset: 3px;
  }

  .dock__tooltip {
    position: absolute;
    bottom: calc(100% + var(--space-3));
    left: 50%;
    translate: -50% 0;
    padding: 3px var(--space-2);
    background: var(--color-tooltip-bg);
    border: var(--border-thin) solid var(--color-tooltip-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-paper);
    font-size: var(--text-tooltip);
    white-space: nowrap;
    color: var(--color-tooltip-text);
    visibility: hidden;
    pointer-events: none;
  }

  .dock__item:hover .dock__tooltip,
  .dock__item:has(:focus-visible) .dock__tooltip {
    visibility: visible;
  }

  /* Running-app dot */
  .dock__dot {
    width: var(--dock-dot-size);
    height: var(--dock-dot-size);
    margin-top: 2px;
    border-radius: 50%;
    background: var(--color-dock-dot);
    visibility: hidden;
  }

  .dock__item[data-running] .dock__dot {
    visibility: visible;
  }

  .dock__separator {
    align-self: stretch;
    width: var(--border-thin);
    margin: var(--space-1) var(--space-1) calc(var(--dock-dot-size) + var(--space-2));
    background: var(--color-dock-separator);
  }

  /* ---- Phone: iOS-style dock row, hidden while an app is full-screen ---- */
  @media (max-width: 767px) {
    .dock {
      left: var(--space-2);
      right: var(--space-2);
      translate: none;
      padding: var(--space-3) var(--space-4);
    }

    .dock__list {
      justify-content: space-around;
    }

    .dock__item--desktop-only,
    .dock__tooltip,
    .dock__dot {
      display: none;
    }

    .dock__button {
      width: var(--home-icon-size);
    }

    :global(html.has-open-window) .dock {
      display: none;
    }
  }
</style>

<script>
  // ---- GSAP hooks for dock magnification. Fill these in later. ----
  /** Pointer entered a dock item. */
  function onDockHover(_item: HTMLElement, _index: number) {}
  /** Pointer moved over the dock (use clientX to scale neighbours). */
  function onDockMove(_e: PointerEvent) {}
  /** Pointer left the dock. */
  function onDockLeave() {}

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const items = [...dock.querySelectorAll<HTMLElement>('[data-dock-item]')];
    items.forEach((item, index) => {
      item.addEventListener('pointerenter', () => {
        onDockHover(item, index);
        document.dispatchEvent(new CustomEvent('dock:hover', { detail: { item, index } }));
      });
    });
    dock.addEventListener('pointermove', (e) => {
      onDockMove(e);
      document.dispatchEvent(new CustomEvent('dock:move', { detail: { event: e } }));
    });
    dock.addEventListener('pointerleave', () => {
      onDockLeave();
      document.dispatchEvent(new CustomEvent('dock:leave'));
    });
  }
</script>
