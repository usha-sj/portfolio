---
// One folder per project (all of them, by `order`), in the right-hand column.
// Click selects, double-click or Enter opens (like Finder).
import { getCollection } from 'astro:content';
import { desktopConfig } from '../../config/desktop';
import FolderIcon from '../icons/FolderIcon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="folders" aria-label={desktopConfig.folders.label} data-select-group>
  {
    projects.map((p) => (
      <li>
        <button type="button" class="folder" data-select-open={`project/${p.id}`} aria-describedby="select-open-hint">
          <span class="folder__icon">
            <FolderIcon cover={p.data.cover} />
          </span>
          <span class="folder__label">{p.data.title}</span>
        </button>
      </li>
    ))
  }
</ul>
<!-- Shared hint for every select-then-open icon (desktop, Finder, folder windows) -->
<p id="select-open-hint" class="visually-hidden">{desktopConfig.folders.hint}</p>

<style>
  .folders {
    position: fixed;
    top: calc(var(--menubar-h) + var(--desktop-pad));
    right: var(--desktop-pad);
    z-index: var(--z-folders);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    width: var(--folder-col-w);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .folder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    width: var(--folder-label-w);
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-system);
    font-size: var(--text-xs);
    color: var(--color-folder-label);
    cursor: default;
  }

  .folder__icon {
    width: calc(var(--folder-icon-size) + var(--space-2));
    padding: var(--space-1);
    border-radius: var(--radius-sm);
  }

  .folder__label {
    max-width: 100%;
    padding: 1px var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-folder-label-bg);
    font-weight: 500;
    text-align: center;
    text-shadow: var(--shadow-folder-label);
    overflow-wrap: anywhere;
  }

  .folder[data-selected] .folder__icon {
    background: var(--color-selection);
  }

  .folder[data-selected] .folder__label {
    background: var(--color-folder-label-selected-bg);
    color: var(--color-folder-label-selected-text);
    text-shadow: none;
  }

  .folder:focus-visible {
    outline: none;
  }

  .folder:focus-visible .folder__icon {
    outline: 2px solid var(--color-focus);
  }

  @media (max-width: 767px) {
    .folders {
      display: none;
    }
  }
</style>

<script>
  // Click selects, double-click or Enter opens (shared with Finder and folder windows)
  import { initSelection } from '../../scripts/selection';
  initSelection();
</script>
