---
// Dock/home icons: macOS-style shapes and depth (gradient tile + top shine),
// recoloured to the site palette. Original drawings, not Apple's artwork.
// To use your own image instead, set `icon` for that app in src/config/apps.ts.
// Tile gradients: --icon-*-bg in tokens.css. Glyph gradients: IconDefs.astro.
import { apps, type AppId } from '../../config/apps';

interface Props {
  app: AppId;
  class?: string;
}

const { app, class: className } = Astro.props;
const custom = (apps[app] as { icon?: string }).icon;
---

<span class:list={['app-icon', `app-icon--${app}`, custom && 'app-icon--custom', className]} aria-hidden="true">
  {
    custom ? (
      <img src={custom} alt="" />
    ) : (
      <svg viewBox="0 0 100 100">
        {app === 'finder' && (
          <path
            class="fi-fg"
            d="M24 35a5 5 0 0 1 5-5h14l5 5h23a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H29a5 5 0 0 1-5-5z"
          />
        )}
        {app === 'notes' && (
          <>
            <rect class="no-band" width="100" height="26" />
            <path class="no-lines" d="M14 44h72M14 58h72M14 72h72M14 86h72" />
          </>
        )}
        {app === 'preview' && (
          <>
            <g transform="rotate(-6 46 46)">
              <rect class="pr-frame" x="15" y="19" width="58" height="50" rx="3" />
              <rect class="pr-sky" x="19" y="23" width="50" height="42" />
              <path class="pr-hill" d="M19 65V51c10-8 18-8 26-2s14 6 24-2v18z" />
            </g>
            <circle class="pr-lens" cx="66" cy="66" r="13" />
            <path class="pr-handle" d="M75.5 75.5 86 86" />
          </>
        )}
        {app === 'mail' && (
          <>
            <rect class="ma-fg" x="18" y="29" width="64" height="42" rx="5" />
            <path class="ma-flap" d="m21 33 29 21 29-21" />
          </>
        )}
        {app === 'terminal' && (
          <>
            <rect class="te-screen" x="10" y="13" width="80" height="74" rx="9" />
            <path class="te-fg" d="m24 36 12 10-12 10M42 60h16" />
          </>
        )}
        {app === 'trash' && (
          <>
            <path class="tr-body" d="M22 24h56l-6 66a5 5 0 0 1-5 4H33a5 5 0 0 1-5-4z" />
            <path class="tr-rib" d="M36 30l2 58M50 30v58M64 30l-2 58M27 46h46M28 64h44" />
            <rect class="tr-lid" x="18" y="16" width="64" height="10" rx="5" />
          </>
        )}
      </svg>
    )
  }
</span>

<style>
  .app-icon {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-icon);
    box-shadow: var(--shadow-icon), var(--icon-edge);
  }

  /* Soft top highlight, like macOS icons */
  .app-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--icon-shine);
    pointer-events: none;
  }

  .app-icon svg,
  .app-icon img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .app-icon--finder   { background: var(--icon-finder-bg); }
  .app-icon--notes    { background: var(--icon-notes-bg); }
  .app-icon--preview  { background: var(--icon-preview-bg); }
  .app-icon--mail     { background: var(--icon-mail-bg); }
  .app-icon--terminal { background: var(--icon-terminal-bg); }

  /* Trash and custom images: no tile */
  .app-icon--trash,
  .app-icon--custom {
    overflow: visible;
    border-radius: 0;
    box-shadow: none;
  }

  .app-icon--trash::after,
  .app-icon--custom::after {
    content: none;
  }

  .app-icon--trash svg {
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.2));
  }

  .fi-fg { fill: var(--color-icon-finder-fg); filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.2)); }

  .no-band { fill: url(#grad-notes-band); }
  .no-lines { stroke: var(--color-icon-notes-lines); stroke-width: 2.5; stroke-dasharray: 2 4; }

  .pr-frame { fill: var(--color-icon-preview-frame); filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.2)); }
  .pr-sky { fill: var(--color-icon-preview-sky); }
  .pr-hill { fill: var(--color-icon-preview-hill); }
  .pr-lens { fill: rgb(255 255 255 / 0.35); stroke: var(--color-icon-preview-lens); stroke-width: 5; }
  .pr-handle { stroke: var(--color-icon-preview-lens); stroke-width: 8; stroke-linecap: round; }

  .ma-fg { fill: var(--color-icon-mail-fg); filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.25)); }
  .ma-flap { fill: none; stroke: var(--color-icon-mail-fold); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }

  .te-screen { fill: var(--color-icon-terminal-screen); }
  .te-fg { fill: none; stroke: var(--color-icon-terminal-fg); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }

  .tr-body { fill: url(#grad-trash); }
  .tr-rib { fill: none; stroke: var(--color-icon-trash-rib); stroke-width: 2; opacity: 0.6; }
  .tr-lid { fill: var(--color-icon-trash-lid); }
</style>
