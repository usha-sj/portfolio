---
// Dock/home icons: SVG redrawings of the current macOS icons (Finder, Notes, Maps, Mail,
// Terminal) plus a mesh Trash. Colours are Apple-like placeholders in tokens.css (--icon-*).
// To use your own image instead, set `icon` for that app in src/config/apps.ts.
// Tile gradients: --icon-*-bg in tokens.css. Glyph gradients: IconDefs.astro.
import { apps, type AppId } from '../../config/apps';

interface Props {
  app: AppId;
  class?: string;
}

const { app, class: className } = Astro.props;
const custom = (apps[app] as { icon?: string }).icon;
---

<span class:list={['app-icon', `app-icon--${app}`, custom && 'app-icon--custom', className]} aria-hidden="true">
  {
    custom ? (
      <img src={custom} alt="" />
    ) : (
      <svg viewBox="0 0 100 100">
        {app === 'finder' && (
          <>
            {/* pale profile on the right; eyes and smile on top */}
            <path
              class="fi-face"
              d="M54 7h25q14 0 14 14v58q0 14-14 14H57q-6 0-6-6V60.5q0-4-4-4h-5q-3.6 0-2.7-3.4L49 11q1-4 5-4z"
            />
            <rect class="fi-feature" x="25" y="30" width="3.6" height="9.4" rx="1.8" />
            <rect class="fi-feature" x="68" y="30" width="3.6" height="9.4" rx="1.8" />
            <path class="fi-smile" d="M19.5 66Q48 92 76 66" />
          </>
        )}
        {app === 'notes' && (
          <>
            <rect class="no-shadow" y="25" width="100" height="2.6" />
            <rect class="no-band" width="100" height="25" />
            <path class="no-perf" d="M1.25 30.4H100" />
            <path class="no-lines" d="M0 50h100M0 75h100" />
          </>
        )}
        {app === 'maps' && (
          <>
            {/* roads are the tile colour; regions get white edges */}
            <path class="mp-green mp-edge" d="M-5 -5H23V24.7L-5 6.8z" />
            <path class="mp-green mp-edge" d="M53 -5H105V77.2L53 43.9z" />
            <circle class="mp-ring mp-edge" cx="100" cy="0" r="37.5" />
            <circle class="mp-green mp-edge" cx="100" cy="0" r="21" />
            <path class="mp-pink mp-edge" d="M-5 38.8L23 56.7V105H-5z" />
            <path class="mp-yellow mp-edge" d="M53 75.9L97 104H53z" />
            <path class="mp-lane" d="M26.2 -2V44M49.8 -2V44" />
            <rect class="mp-route" x="28.4" y="-2" width="19.4" height="48" />
            <g class="mp-badge">
              <circle class="mp-badge-ring" cx="38" cy="62" r="25" />
              <circle class="mp-badge-fill" cx="38" cy="62" r="21.2" />
              <path class="mp-arrow" d="M38 46.5l10 27.2-10-9-10 9z" />
            </g>
          </>
        )}
        {app === 'mail' && (
          <>
            <rect class="ma-body" x="20" y="30" width="60" height="40" rx="5" />
            <path class="ma-lower" d="M22.5 68.5L50 48.5l27.5 20z" />
            <path class="ma-flap" d="M22 31.5h56L56 52q-6 5.5-12 0z" />
            <rect class="ma-rim" x="20" y="30" width="60" height="40" rx="5" />
          </>
        )}
        {app === 'terminal' && (
          <>
            <path class="te-chevron" d="M20 21.5l16.5 10-16.5 10" />
            <path class="te-cursor" d="M40.5 50h19.5" />
          </>
        )}
        {app === 'trash' && (
          <>
            {/* frosted bin, full of crumpled paper */}
            <ellipse class="tr-inside" cx="50" cy="15" rx="34" ry="6" />
            <path class="tr-paper" d="M22 15l3-8 9-3 4 5 6-6 8 2 2 7z" />
            <path class="tr-paper tr-paper--shade" d="M45 15l2-9 10-4 7 3 6-3 8 6-3 7z" />
            <path class="tr-bit tr-bit--blue" d="M39 10l6-3 5 2-4 4z" />
            <path class="tr-bit tr-bit--green" d="M46 9l5-2 3 3-5 2z" />
            <path class="tr-bit tr-bit--orange" d="M57 7l8-1 2 6-8 2z" />
            <path class="tr-paper" d="M30 16l5-6 8 1 4-3 6 4-2 5z" />
            <path class="tr-paper" d="M62 16l3-6 8-1 6 4-2 4z" />
            <path class="tr-body" d="M16 15a34 6 0 0 0 68 0l-5 72q-.6 8-8.5 8h-41q-7.9 0-8.5-8z" />
            <path class="tr-body-shade" d="M16 15a34 6 0 0 0 68 0l-5 72q-.6 8-8.5 8h-41q-7.9 0-8.5-8z" />
            <ellipse class="tr-rim" cx="50" cy="15" rx="34" ry="6" />
          </>
        )}
      </svg>
    )
  }
</span>

<style>
  .app-icon {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-icon);
    box-shadow: var(--shadow-icon), var(--icon-edge);
  }

  /* Soft top highlight, like macOS icons */
  .app-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--icon-shine);
    pointer-events: none;
  }

  .app-icon svg,
  .app-icon img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .app-icon--finder   { background: var(--icon-finder-bg); }
  .app-icon--notes    { background: var(--icon-notes-bg); }
  .app-icon--maps     { background: var(--icon-maps-bg); }
  .app-icon--mail     { background: var(--icon-mail-bg); }
  .app-icon--terminal { background: var(--icon-terminal-bg); box-shadow: var(--shadow-icon), var(--icon-terminal-rim); }

  /* Trash and custom images: no tile */
  .app-icon--trash,
  .app-icon--custom {
    overflow: visible;
    border-radius: 0;
    box-shadow: none;
  }

  .app-icon--trash::after,
  .app-icon--custom::after {
    content: none;
  }

  .app-icon--trash svg {
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.2));
  }

  .fi-face { fill: url(#grad-finder-face); stroke: var(--color-icon-finder-face-rim); stroke-width: 0.8; }
  .fi-feature { fill: var(--color-icon-finder-features); filter: var(--icon-glyph-shadow); }
  .fi-smile { fill: none; stroke: var(--color-icon-finder-features); stroke-width: 2.5; stroke-linecap: round; filter: var(--icon-glyph-shadow); }

  .no-band { fill: url(#grad-notes-band); }
  .no-shadow { fill: url(#grad-notes-shadow); }
  .no-perf { stroke: var(--color-icon-notes-perf); stroke-width: 2.5; stroke-dasharray: 0 4.17; stroke-linecap: round; }
  .no-lines { stroke: var(--color-icon-notes-lines); stroke-width: 1.7; }

  .mp-edge { stroke: var(--color-icon-maps-edge); stroke-width: 1.4; }
  .mp-green { fill: url(#grad-maps-green); }
  .mp-ring { fill: var(--color-icon-maps-ring); }
  .mp-pink { fill: var(--color-icon-maps-pink); }
  .mp-yellow { fill: var(--color-icon-maps-yellow); }
  .mp-lane { stroke: var(--color-icon-maps-edge); stroke-width: 1.4; }
  .mp-route { fill: url(#grad-maps-route); }
  .mp-badge { filter: var(--icon-badge-shadow); }
  .mp-badge-ring { fill: var(--color-icon-maps-edge); }
  .mp-badge-fill { fill: url(#grad-maps-badge); }
  .mp-arrow { fill: var(--color-icon-maps-arrow); stroke: var(--color-icon-maps-arrow); stroke-width: 1.6; stroke-linejoin: round; }

  .ma-body { fill: url(#grad-mail-body); }
  .ma-lower { fill: url(#grad-mail-lower); stroke: var(--color-icon-mail-rim); stroke-width: 0.8; stroke-linejoin: round; }
  .ma-flap { fill: url(#grad-mail-flap); stroke: var(--color-icon-mail-rim); stroke-width: 0.8; stroke-linejoin: round; filter: var(--icon-glyph-shadow); }
  .ma-rim { fill: none; stroke: var(--color-icon-mail-rim); stroke-width: 1.2; }

  .te-chevron { fill: none; stroke: url(#grad-terminal-chevron); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; filter: var(--icon-glyph-shadow); }
  .te-cursor { fill: none; stroke: var(--color-icon-terminal-cursor); stroke-width: 3; stroke-linecap: round; }

  .tr-inside { fill: var(--color-icon-trash-inside); }
  .tr-paper { fill: var(--color-icon-trash-paper); stroke: var(--color-icon-trash-paper-edge); stroke-width: 0.6; stroke-linejoin: round; }
  .tr-paper--shade { fill: var(--color-icon-trash-paper-shade); }
  .tr-bit--blue { fill: var(--color-icon-trash-bit-blue); }
  .tr-bit--green { fill: var(--color-icon-trash-bit-green); }
  .tr-bit--orange { fill: var(--color-icon-trash-bit-orange); }
  .tr-body { fill: url(#grad-trash); opacity: 0.94; }
  .tr-body-shade { fill: url(#grad-trash-sides); }
  .tr-rim { fill: none; stroke: var(--color-icon-trash-rim); stroke-width: 1.6; }
</style>
