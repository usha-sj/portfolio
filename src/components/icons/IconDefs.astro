---
// Shared SVG gradients for icons, rendered once per page. Icons reference them with
// fill="url(#...)". Kept in a 0×0 (not display:none) SVG so the gradients always resolve,
// including inside windows cloned from templates. Colours come from tokens.css.
---

<svg class="icon-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="grad-folder-back" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-folder-back-top)" />
      <stop offset="1" style="stop-color: var(--color-folder-back-bottom)" />
    </linearGradient>
    <linearGradient id="grad-folder-front" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-folder-front-top)" />
      <stop offset="1" style="stop-color: var(--color-folder-front-bottom)" />
    </linearGradient>
    <linearGradient id="grad-notes-band" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-notes-band-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-notes-band-bottom)" />
    </linearGradient>
    <linearGradient id="grad-notes-shadow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-notes-band-shadow)" />
      <stop offset="1" style="stop-color: var(--color-icon-notes-band-shadow); stop-opacity: 0" />
    </linearGradient>
    <linearGradient id="grad-trash" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-trash-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-trash-bottom)" />
    </linearGradient>
    <linearGradient id="grad-finder-face" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-finder-face-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-finder-face-bottom)" />
    </linearGradient>
    <linearGradient id="grad-maps-green" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-maps-green-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-maps-green-bottom)" />
    </linearGradient>
    <linearGradient id="grad-maps-route" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-maps-route-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-maps-route-bottom)" />
    </linearGradient>
    <linearGradient id="grad-maps-badge" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-maps-badge-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-maps-badge-bottom)" />
    </linearGradient>
    <linearGradient id="grad-mail-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-mail-body-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-mail-body-bottom)" />
    </linearGradient>
    <linearGradient id="grad-mail-lower" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-mail-lower-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-mail-lower-bottom)" />
    </linearGradient>
    <linearGradient id="grad-mail-flap" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-mail-flap-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-mail-flap-bottom)" />
    </linearGradient>
    <linearGradient id="grad-terminal-chevron" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--color-icon-terminal-chevron-top)" />
      <stop offset="1" style="stop-color: var(--color-icon-terminal-chevron-bottom)" />
    </linearGradient>
    <linearGradient id="grad-trash-sides" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style="stop-color: var(--color-icon-trash-side); stop-opacity: 0.55" />
      <stop offset="0.3" style="stop-color: var(--color-icon-trash-side); stop-opacity: 0" />
      <stop offset="0.7" style="stop-color: var(--color-icon-trash-side); stop-opacity: 0" />
      <stop offset="1" style="stop-color: var(--color-icon-trash-side); stop-opacity: 0.55" />
    </linearGradient>
  </defs>
</svg>

<style>
  .icon-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
