---
// Original scrapbook folder: kraft-paper folder, a sheet peeking out, a round sticker.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['folder-icon', className]} viewBox="0 0 64 52" aria-hidden="true">
  <!-- back panel with tab -->
  <path class="folder-icon__back" d="M4 8a3 3 0 0 1 3-3h15l5 5h30a3 3 0 0 1 3 3v33a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z" />
  <!-- paper sticking out, slightly askew -->
  <rect class="folder-icon__paper" x="12" y="11" width="38" height="24" rx="1.5" transform="rotate(-4 31 23)" />
  <path class="folder-icon__lines" d="M17 18h20M17 22h26" transform="rotate(-4 31 23)" />
  <!-- front panel -->
  <path class="folder-icon__front" d="M2 21a3 3 0 0 1 3-3h54a3 3 0 0 1 3 3l-2 24a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z" />
  <!-- sticker -->
  <circle class="folder-icon__sticker" cx="48" cy="38" r="5" />
</svg>

<style>
  .folder-icon {
    display: block;
    width: 100%;
    height: auto;
  }

  .folder-icon__back    { fill: var(--color-folder-back); }
  .folder-icon__paper   { fill: var(--color-folder-paper); }
  .folder-icon__lines   { stroke: var(--color-folder-back); stroke-width: 1.2; stroke-linecap: round; }
  .folder-icon__front   { fill: var(--color-folder-front); }
  .folder-icon__sticker { fill: var(--color-folder-sticker); }
</style>
