---
// macOS-shaped folder (tab, back, front panel with a soft gradient) in the site's ink blue.
// Gradients live in IconDefs.astro.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['folder-icon', className]} viewBox="0 0 64 52" aria-hidden="true">
  <path
    class="folder-icon__back"
    d="M3 7.5A3.5 3.5 0 0 1 6.5 4h16.2a3.5 3.5 0 0 1 2.6 1.2l2.6 2.8h29.6A3.5 3.5 0 0 1 61 11.5v34a3.5 3.5 0 0 1-3.5 3.5h-51A3.5 3.5 0 0 1 3 45.5z"
  />
  <path
    class="folder-icon__front"
    d="M3 17.5A3.5 3.5 0 0 1 6.5 14h51a3.5 3.5 0 0 1 3.5 3.5v28a3.5 3.5 0 0 1-3.5 3.5h-51A3.5 3.5 0 0 1 3 45.5z"
  />
  <path class="folder-icon__crease" d="M6 15.2h52" />
</svg>

<style>
  .folder-icon {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.18));
  }

  .folder-icon__back { fill: url(#grad-folder-back); }
  .folder-icon__front { fill: url(#grad-folder-front); }
  .folder-icon__crease { stroke: var(--color-folder-crease); stroke-width: 1; stroke-linecap: round; }
</style>
